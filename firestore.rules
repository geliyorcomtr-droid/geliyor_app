rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          userDoc().user_role == 'admin'
          || userDoc().role == 'admin'
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Kullanıcı profili
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.get('user_role', 'customer') != 'admin'
        && request.resource.data.get('role', '') != 'admin';
      allow update: if isOwner(userId)
        && request.resource.data.get('user_role', resource.data.get('user_role', 'customer'))
          == resource.data.get('user_role', 'customer')
        && request.resource.data.get('role', resource.data.get('role', ''))
          == resource.data.get('role', '')
        || isAdmin();
      allow delete: if isAdmin();

      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /food_reminders/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId);
        allow create, delete: if false;
      }
    }

    // Ürün katalogu — herkes okur, sadece admin yazar
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Siparişler — sahip veya admin
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status)
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['gifts', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Değerlendirmeler
    match /reviews/{reviewId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // Banner / kampanya
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kategoriler — herkes okur, sadece admin yazar
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Markalar — herkes okur, sadece admin yazar
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Güven rozetleri — herkes okur, sadece admin yazar
    match /trust_badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ürün avantajları — herkes okur, sadece admin yazar
    match /product_advantages/{advantageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /food_coupon_queue/{jobId} {
      allow read, write: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isAdmin() || docId == 'bank_transfer';
      allow write: if isAdmin();
    }

    match /otp_codes/{phone} {
      allow read, write: if false;
    }

    match /referral_invite_quota/{uid} {
      allow read, write: if false;
    }

    match /referral_invites/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /support_tickets/{ticketId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
